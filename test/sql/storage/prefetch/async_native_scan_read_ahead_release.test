# name: test/sql/storage/prefetch/async_native_scan_read_ahead_release.test
# description: Exhausted read-ahead scans return their memory reservation, so a hash join built from them stays in memory
# group: [prefetch]

load {TEST_DIR}/async_native_scan_read_ahead_release.db

statement ok
CREATE TABLE build AS SELECT range AS k, range * 2 AS v FROM range(200000);

statement ok
CREATE TABLE probe AS SELECT range % 200000 AS k FROM range(1000000);

statement ok
CHECKPOINT

# restart so the payload blocks begin cold
restart

# keep the union as the build side
statement ok
SET disabled_optimizers='statistics_propagation,join_order,build_side_probe_side,compressed_materialization';

statement ok
SET threads=4

statement ok
SET async_threads=4

statement ok
SET memory_limit='384MB'

statement ok
SET read_ahead_depth=-1

statement ok
SET storage_block_prefetch='debug_force_always'

# Keep the query and its in-memory log in one transaction.
statement ok
BEGIN;

statement ok
CALL enable_logging('PhysicalOperator');

statement ok
CALL truncate_duckdb_logs();

# each union child is its own read-ahead scan, all of them are exhausted before the join finalizes its build
query II
SELECT count(*), sum(b.v)
FROM probe
JOIN (
	SELECT k, v FROM build UNION ALL SELECT k, v FROM build UNION ALL SELECT k, v FROM build UNION ALL
	SELECT k, v FROM build UNION ALL SELECT k, v FROM build UNION ALL SELECT k, v FROM build UNION ALL
	SELECT k, v FROM build UNION ALL SELECT k, v FROM build UNION ALL SELECT k, v FROM build UNION ALL
	SELECT k, v FROM build UNION ALL SELECT k, v FROM build UNION ALL SELECT k, v FROM build
) b USING (k);
----
12000000	2399988000000

statement ok
CALL disable_logging();

# the build side fits in memory once the scans have returned their reservations
query I
SELECT bool_or(info.external::BOOLEAN)::INTEGER
FROM duckdb_logs_parsed('PhysicalOperator')
WHERE class='PhysicalHashJoin' AND event='Finalize';
----
0

statement ok
COMMIT;
